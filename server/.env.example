# Copy to .env for local dev. Placeholders only; never commit a real .env.
DATABASE_URL=postgresql+asyncpg://localhost/light_audible_dev
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=light-audible-dev
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
# Generate with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTH_ENCRYPTION_KEY=replace-with-generated-fernet-key
# Minimum 8 characters; protects the /setup page.
SETUP_PASSWORD=change-me-please
AUDIBLE_LOCALE=us
PUBLIC_BASE_URL=http://localhost:8000
BUCKET_SOFT_LIMIT_BYTES=8000000000
